# -----------------------------------------------------------------------
# Copy this file to .env and adjust values for your environment.
#
# Docker Compose: use service names (kafka, postgres, redis, redis-2, redis-3)
# Running locally outside Docker: use localhost with the mapped ports
# -----------------------------------------------------------------------

HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# API_KEYS: Comma-separated list of shared bearer tokens for authenticating
# requests to /api/jobs endpoints. Leaving this empty disables authentication,
# which is not safe for anything reachable from a network. Health and metrics
# endpoints (/live, /ready, /metrics) are deliberately not covered by this.
# Example: API_KEYS=sk-prod-abc123def456,sk-prod-xyz789ghi012
# API_KEYS=

# Docker Compose: kafka:9092  |  Local: localhost:9092
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=conduit.jobs
KAFKA_CONSUMER_GROUP=conduit-workers
KAFKA_CLIENT_ID=conduit

# Docker Compose: redis:6379,...  |  Local: localhost:6379,localhost:6380,localhost:6381
REDIS_ADDRESSES=redis:6379,redis-2:6379,redis-3:6379
REDIS_DATABASE=0
REDIS_POOL_SIZE=10

# Docker Compose: postgres:5432  |  Local: localhost:5433
POSTGRES_DSN=postgres://conduit:conduit@postgres:5432/conduit?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_MIGRATIONS_PATH=./migrations

WORKER_CONCURRENCY=8
WORKER_QUEUE_SIZE=256
WORKER_SHUTDOWN_TIMEOUT=30s

# WORKER_QUEUES: Comma-separated list of queue names this instance's built-in
# worker will claim jobs from. Leaving this empty means the worker will claim
# from all queues, which is the default behavior.
# Example: WORKER_QUEUES=high-priority,normal,low-priority
# WORKER_QUEUES=

SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL=1s
SCHEDULER_MAX_CONCURRENT_RUNS=2

RECONCILER_ENABLED=true
RECONCILER_INTERVAL=1s
RECONCILER_IDLE_INTERVAL=15s
RECONCILER_BATCH_SIZE=100
RECONCILER_RUNNING_LEASE=5m

WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_REDIRECTS=0
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

METRICS_NAMESPACE=conduit
METRICS_SUBSYSTEM=service

LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE_NAME=conduit
LOG_ENVIRONMENT=development
