# -----------------------------------------------------------------------
# Copy this file to .env and adjust values for your environment.
#
# Every name here is prefixed CONDUIT_, and the server ignores the
# unprefixed spelling. API_KEYS and POSTGRES_DSN are why: both are
# generic enough to already mean something else in a shared environment.
#
# Docker Compose: use service names (kafka, postgres, redis, redis-2, redis-3)
# Running locally outside Docker: use localhost with the mapped ports
# -----------------------------------------------------------------------

CONDUIT_HTTP_ADDRESS=:8080
CONDUIT_HTTP_READ_TIMEOUT=5s
CONDUIT_HTTP_WRITE_TIMEOUT=10s
CONDUIT_HTTP_IDLE_TIMEOUT=60s

# CONDUIT_API_KEYS: Comma-separated list of shared bearer tokens for authenticating
# requests to /api/jobs endpoints. Leaving this empty disables authentication,
# which is not safe for anything reachable from a network. Health and metrics
# endpoints (/live, /ready, /metrics) are deliberately not covered by this,
# which is why the reverse proxy in front is what keeps them private.
# Generate one with: openssl rand -hex 32
# Minimum 16 characters. These are bearer tokens over plain HTTP, so terminate
# TLS in front of the server. See docs/DEPLOYMENT.md.
# CONDUIT_API_KEYS=

# CONDUIT_TRUSTED_PROXIES: Comma-separated CIDRs allowed to set X-Forwarded-For.
# Empty (the default) means trust nothing, so the logged client_ip is the
# direct peer and cannot be forged. Set this to your reverse proxy's network
# to log real client addresses instead of the proxy's.
# Example: CONDUIT_TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32
# CONDUIT_TRUSTED_PROXIES=

# CONDUIT_TRANSPORT: postgres | kafka. How a freshly enqueued job wakes a
# worker. Neither carries authority: Postgres is the source of truth and the
# reconciler is the guaranteed delivery path, so a transport that drops a
# message costs dispatch latency and nothing else. postgres uses LISTEN/NOTIFY
# and needs no broker; kafka needs the settings below and `--profile kafka`.
CONDUIT_TRANSPORT=postgres

# CONDUIT_LOCK: none | advisory | redlock. What stops two instances executing
# one job at once. This guards duplicated effort, not correctness - the lease
# token in every state-changing WHERE clause is what makes execution safe.
# advisory uses pg_try_advisory_lock and needs nothing extra. redlock needs the
# Redis settings below and `--profile redis`. none is only sensible with
# CONDUIT_TRANSPORT=postgres, where every dispatch already goes through an
# atomic FOR UPDATE SKIP LOCKED claim.
CONDUIT_LOCK=advisory

# Only read when CONDUIT_TRANSPORT=kafka.
# Docker Compose: kafka:9092  |  Local: localhost:9092
CONDUIT_KAFKA_BROKERS=kafka:9092
CONDUIT_KAFKA_TOPIC=conduit.jobs
CONDUIT_KAFKA_CONSUMER_GROUP=conduit-workers
CONDUIT_KAFKA_CLIENT_ID=conduit

# Only read when CONDUIT_LOCK=redlock.
# Docker Compose: redis:6379,...  |  Local: localhost:6379,localhost:6380,localhost:6381
CONDUIT_REDIS_ADDRESSES=redis:6379,redis-2:6379,redis-3:6379
CONDUIT_REDIS_DATABASE=0
CONDUIT_REDIS_POOL_SIZE=10

# Docker Compose: postgres:5432  |  Local: localhost:5433
CONDUIT_POSTGRES_DSN=postgres://conduit:conduit@postgres:5432/conduit?sslmode=disable
CONDUIT_POSTGRES_MAX_CONNS=10
CONDUIT_POSTGRES_MIN_CONNS=1
CONDUIT_POSTGRES_MIGRATIONS_PATH=./migrations

CONDUIT_WORKER_CONCURRENCY=8
CONDUIT_WORKER_QUEUE_SIZE=256
CONDUIT_WORKER_SHUTDOWN_TIMEOUT=30s

# CONDUIT_WORKER_QUEUES: Comma-separated list of queue names this instance's built-in
# worker and reconciler will claim from. Empty means all queues.
#
# Set this as soon as you run remote workers. Empty means this process competes
# for the jobs your workers are meant to run, and it will dead-letter them for
# having no registered handler. If your remote workers claim from `remote`, set
# CONDUIT_WORKER_QUEUES=default here so the two do not fight.
# Example: CONDUIT_WORKER_QUEUES=default
# CONDUIT_WORKER_QUEUES=

CONDUIT_SCHEDULER_ENABLED=true
CONDUIT_SCHEDULER_TICK_INTERVAL=1s
CONDUIT_SCHEDULER_MAX_CONCURRENT_RUNS=2

CONDUIT_RECONCILER_ENABLED=true
CONDUIT_RECONCILER_INTERVAL=1s
CONDUIT_RECONCILER_IDLE_INTERVAL=15s
CONDUIT_RECONCILER_BATCH_SIZE=500
CONDUIT_RECONCILER_RUNNING_LEASE=5m

CONDUIT_WEBHOOK_TIMEOUT=10s
CONDUIT_WEBHOOK_MAX_REDIRECTS=0
CONDUIT_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

CONDUIT_METRICS_NAMESPACE=conduit
CONDUIT_METRICS_SUBSYSTEM=server

CONDUIT_LOG_LEVEL=info
CONDUIT_LOG_FORMAT=json
CONDUIT_LOG_SERVICE_NAME=conduit
CONDUIT_LOG_ENVIRONMENT=development
